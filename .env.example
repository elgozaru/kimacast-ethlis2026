# Consolidated reference for every environment variable used across this
# repo's three services. This file is NOT loaded by any of them — each
# service reads its own .env from its own directory, since they run as
# separate processes (and Vite only looks at apps/web/.env.local, not a
# repo-root file). Copy each section below into the matching per-app file:
#
#   cp apps/facilitator/.env.example      apps/facilitator/.env
#   cp apps/resource-server/.env.example  apps/resource-server/.env
#   cp apps/web/.env.example              apps/web/.env.local
#
# See docs/SETUP.md for what each value means and where to get it.


# ============================================================
# apps/facilitator/.env
# ============================================================
# Runs the platform's own x402 facilitator for Hedera: the operator account
# below pays the network fee on every settled payment, which is what lets a
# viewer with zero HBAR still authorize a payment.

# "hedera:testnet" while building, "hedera:mainnet" to go live.
HEDERA_NETWORK=hedera:testnet

# Get this from https://portal.hedera.com/ (sign up, create a testnet
# account, claim testnet HBAR). Must be an ECDSA (secp256k1) key — ED25519
# is not supported by the signing helper this app uses.
HEDERA_FACILITATOR_ACCOUNT_ID=0.0.CHANGE_ME
HEDERA_FACILITATOR_PRIVATE_KEY=0xCHANGE_ME

# "allow" lets a story's payTo be an EVM-address alias for a content agent
# whose Hedera account hasn't been explicitly created yet. Set to "reject"
# once every agent has a confirmed, funded Hedera account.
HEDERA_ALIAS_POLICY=allow

PORT=4021


# ============================================================
# apps/resource-server/.env
# ============================================================
# The paywall itself: serves free teasers and the x402-gated full story,
# plus (as of the Vite migration) the one endpoint that needs a real server
# to hold a secret: POST /api/hedera/sign, which co-signs a viewer's Hedera
# transaction via Privy's server Wallet API.

HEDERA_NETWORK=hedera:testnet

# Where apps/facilitator is running. Point this at a third-party
# Hedera-compatible x402 facilitator instead (e.g. AlgoVoi) if you'd rather
# not run your own fee-payer operator account.
FACILITATOR_URL=http://localhost:4021

# Any Ethereum RPC provider (Alchemy, Infura, a public endpoint, etc.) — used
# read-only to resolve each content agent's ENS text record
# ("me.hedera.account") to its Hedera payout account. This app never signs
# anything with it.
ETH_RPC_URL=https://CHANGE_ME

# From dashboard.privy.io -> your app -> Settings / API Keys. Used by
# POST /api/hedera/sign. PRIVY_APP_SECRET lives here and ONLY here — never
# put it in apps/web (a static Vite build has nowhere to keep a secret).
PRIVY_APP_ID=CHANGE_ME
PRIVY_APP_SECRET=CHANGE_ME

PORT=4000


# ============================================================
# apps/web/.env.local
# ============================================================
# The Instagram-linked viewer page (Vite + React Router): teaser, Privy
# login, wallet, funding check, sign & pay, unlocked content.

# From dashboard.privy.io -> your app -> Settings.
VITE_PRIVY_APP_ID=CHANGE_ME

VITE_HEDERA_NETWORK=hedera:testnet

# Only needed if apps/resource-server isn't reachable at
# http://localhost:4000 from wherever `vite` itself runs — this configures
# vite.config.ts's dev proxy target, which is what the browser's /api/*
# calls actually go through (same-origin from the browser's point of view,
# so there's no CORS/forwarded-hostname footgun here).
# RESOURCE_SERVER_URL=http://localhost:4000
