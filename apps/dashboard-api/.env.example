# --- Database (shared with apps/resource-server for reading Posts) ---
DATABASE_URL=postgresql://kimacast:kimacast@localhost:5432/kimacast

# --- Privy (verifies the creator dashboard's access token) ---
PRIVY_APP_ID=CHANGE_ME
PRIVY_APP_SECRET=CHANGE_ME

# --- Anthropic (the default LLM behind the content-generation pipeline) ---
# Billed separately from any Claude subscription (claude.ai, Claude Code) -
# this is pay-as-you-go API credit, added at console.anthropic.com under
# Plans & Billing. A 400 "credit balance is too low" means that account
# needs topping up, not that a subscription should have covered this.
ANTHROPIC_API_KEY=CHANGE_ME

# --- 0G Compute Network (generation/zgCompute.ts) - alternative to Anthropic
#     above, picked per-agent via settings.generationProvider ("0g-compute"),
#     see Onboarding's "Generation model" field. Runs on 0G's decentralized
#     inference marketplace instead of Claude - open-weight models only
#     (DeepSeek, Qwen, GPT-OSS as of writing, not Claude), paid from a 0G
#     Compute ledger balance instead of a USD credit balance. ---
# Same RPC as 0G Storage above - this is just the 0G chain's EVM endpoint,
# not an inference endpoint (the real inference URL comes from each
# provider's on-chain service registration).
ZEROG_COMPUTE_RPC=https://evmrpc-testnet.0g.ai
# A wallet holding 0G testnet ("Galileo") tokens - get some from 0G's
# testnet faucet. The first generate() call auto-creates this wallet's
# Compute Network ledger (minimum 3 0G) if it doesn't exist yet; override
# the initial deposit with ZEROG_COMPUTE_INITIAL_DEPOSIT_OG if 3 isn't
# enough headroom for your testing volume.
ZEROG_COMPUTE_PRIVATE_KEY=CHANGE_ME
# ZEROG_COMPUTE_INITIAL_DEPOSIT_OG=3

# --- 0G Storage (immutable source snapshots + generation results) ---
ZEROG_STORAGE_RPC=https://evmrpc-testnet.0g.ai
ZEROG_STORAGE_INDEXER=https://indexer-storage-testnet-turbo.0g.ai
ZEROG_STORAGE_PRIVATE_KEY=CHANGE_ME

# --- ENS subname automation ---
# Read-only RPC for the network kymacast.eth's subnames actually live on
# (Sepolia during testing - see docs/SETUP.md's ENS section for why the
# network must match where the domain is registered).
ETH_RPC_URL=CHANGE_ME
ENS_PARENT_DOMAIN=kymacast.eth
# A FRESH, dedicated key - never the domain owner's personal wallet.
# Generate with: npx tsx scripts/generate-ens-operator-key.ts
ENS_OPERATOR_PRIVATE_KEY=CHANGE_ME
# Optional override; defaults to the confirmed Sepolia PublicResolver.
# ENS_RESOLVER_ADDRESS=0xE99638b40E4Fff0129D56f03b55b6bbC4BBE49b5

# --- AgentRegistry.sol (packages/contracts) - optional, for the ENS sponsor
#     bounty track. Not required for the platform to function; leave unset
#     and deploy skips it entirely. Deploy with:
#       cd packages/contracts && forge script script/DeployAgentRegistry.s.sol:DeployAgentRegistry --rpc-url $ETH_RPC_URL --private-key <deployer-key> --broadcast
#     then paste the printed address below.
# AGENT_REGISTRY_ADDRESS=

# --- X (Twitter) publishing: platform-level fallback (social/twitter.ts) ---
# Used when a post's "x" channel has no per-creator SocialConnection bound
# (see X_OAUTH_CLIENT_ID below for the real per-creator login). See
# x-agent/README.md for credential setup and troubleshooting.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# --- Telegram publishing (social/telegram.ts) ---
# One bot token for the whole platform - the thing that varies per agent is
# the destination chat, set per agent as settings.telegramChatId
# (dashboard's Onboarding page), not a second bot token. Create a bot via
# @BotFather, then add it as an admin to whatever channel/group each agent
# should post into. Telegram deliberately has no per-creator OAuth
# connection below - there's no such login for a bot to connect to.
TELEGRAM_BOT_TOKEN=

# --- Per-creator social connections (routes/socialConnections.ts) ---
# Lets a creator connect their OWN X/Instagram account from the dashboard's
# Connections page, instead of every agent posting through one shared
# platform credential. See docs/SETUP.md for the full explanation,
# including Instagram's Business/Creator account requirement (no bypass -
# personal accounts have no publish API at all) and its text-only-post
# limitation.
# 32 bytes, hex or base64 - generate with: openssl rand -hex 32
SOCIAL_TOKEN_ENCRYPTION_KEY=CHANGE_ME
# X Developer Portal OAuth 2.0 app - callback URL
# <DASHBOARD_API_ORIGIN>/api/social/x/callback
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=
# Meta App (Facebook Login for Business) - callback URL
# <DASHBOARD_API_ORIGIN>/api/social/instagram/callback
META_APP_ID=
META_APP_SECRET=
# This service's own externally-reachable origin, for building the two
# callback URLs above.
DASHBOARD_API_ORIGIN=http://localhost:4100
# The dashboard frontend's origin - where the OAuth callback redirects the
# browser back to once a connection is complete.
DASHBOARD_APP_ORIGIN=http://localhost:3010

# --- Where apps/web is served, for building each post's x402 unlock URL ---
WEB_APP_ORIGIN=http://localhost:3000

PORT=4100
