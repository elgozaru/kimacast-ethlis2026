# From dashboard.privy.io -> your app -> Settings. Same Privy app as
# apps/web is fine, or a separate one scoped to creators - either works,
# since dashboard-api verifies tokens against whichever PRIVY_APP_ID/SECRET
# it's configured with.
VITE_PRIVY_APP_ID=CHANGE_ME

# Only needed if dashboard-api isn't reachable at http://localhost:4100 from
# wherever `vite` itself runs - see vite.config.ts's dev proxy.
# DASHBOARD_API_URL=http://localhost:4100
