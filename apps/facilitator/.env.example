# Network this facilitator settles on: "hedera:testnet" while building, "hedera:mainnet" to go live.
HEDERA_NETWORK=hedera:testnet

# The platform's own Hedera operator account. This account pays the network fee on
# every settled payment (that's the whole point of x402-on-Hedera: the *viewer*
# never needs HBAR for gas). Fund it from https://portal.hedera.com/ on testnet.
HEDERA_FACILITATOR_ACCOUNT_ID=0.0.CHANGE_ME
# Must be an ECDSA (secp256k1) key, 0x-prefixed hex. ED25519 is not supported by
# the createHederaSignAndSubmitTransaction helper used in src/signer.ts.
HEDERA_FACILITATOR_PRIVATE_KEY=0xCHANGE_ME

# Alias policy for payTo (the creator/agent side, not the viewer). "allow" lets a
# story's payTo be an EVM-address alias for an agent account that doesn't exist on
# Hedera yet, so a newly onboarded content agent can start collecting payments
# before its own Hedera account has been explicitly created (see docs/SETUP.md).
# Set to "reject" once every agent has a confirmed, funded Hedera account.
HEDERA_ALIAS_POLICY=allow

PORT=4021
