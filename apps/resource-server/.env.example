HEDERA_NETWORK=hedera:testnet

# Where apps/facilitator is running. In production this could instead point at
# a third-party Hedera-compatible x402 facilitator (e.g. AlgoVoi) if you'd
# rather not run your own fee-payer operator account.
FACILITATOR_URL=http://localhost:4021

# Read-only Ethereum RPC used to resolve each agent's ENS subdomain to its
# Hedera payout account (text record "me.hedera.account"). Any provider works
# (Alchemy/Infura/etc) — this app never signs anything with it.
ETH_RPC_URL=https://CHANGE_ME

PORT=4000
