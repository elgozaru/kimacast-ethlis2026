HEDERA_NETWORK=hedera:testnet

# Where apps/facilitator is running. In production this could instead point at
# a third-party Hedera-compatible x402 facilitator (e.g. AlgoVoi) if you'd
# rather not run your own fee-payer operator account.
FACILITATOR_URL=http://localhost:4021

# Read-only Ethereum RPC used to resolve each agent's ENS subdomain to its
# Hedera payout account (text record "me.hedera.account"). Any provider works
# (Alchemy/Infura/etc) — this app never signs anything with it.
ETH_RPC_URL=https://CHANGE_ME

# From dashboard.privy.io -> your app -> Settings / API Keys. Used by
# POST /api/hedera/sign to co-sign a viewer's Hedera transaction via Privy's
# server Wallet API. This is the one place PRIVY_APP_SECRET lives — never
# ship it to apps/web (a static Vite build has nowhere to keep a secret).
PRIVY_APP_ID=CHANGE_ME
PRIVY_APP_SECRET=CHANGE_ME

# A SEPARATE credential from the app secret above - required for any call
# to a wallet's RPC endpoint (which secp256k1Sign uses), including the
# co-signing this route does. From dashboard.privy.io -> Authorization keys
# -> New key (private key shown once, save it here) - then register that
# key's public half as an authorized signer ("key quorum") for the
# embedded wallets that need raw signing. Without this, secp256k1Sign
# doesn't error cleanly - it comes back with no signature at all.
PRIVY_WALLET_AUTHORIZATION_PRIVATE_KEY=CHANGE_ME

PORT=4000
