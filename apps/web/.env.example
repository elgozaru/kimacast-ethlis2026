# From the Privy dashboard (dashboard.privy.io) → your app → Settings.
# PRIVY_APP_SECRET is NOT needed here — it now lives in
# apps/resource-server/.env, since that's the process that actually holds
# it (a static Vite build has nowhere to keep a secret).
VITE_PRIVY_APP_ID=CHANGE_ME

# The PUBLIC id of the authorization key registered in the Privy dashboard
# (Wallet infrastructure -> Authorization keys) - used client-side to grant
# apps/resource-server's signing requests access to a viewer's embedded
# wallet via useSessionSigners (this app's wallets use Privy's TEE
# execution model, so useDelegatedActions/on-device delegation doesn't
# apply here). This is just an id, not a secret - the matching PRIVATE key
# lives only in apps/resource-server/.env as
# PRIVY_WALLET_AUTHORIZATION_PRIVATE_KEY, never here.
VITE_PRIVY_SESSION_SIGNER_ID=CHANGE_ME

VITE_HEDERA_NETWORK=hedera:testnet

# Only needed to point at a resource-server that ISN'T reachable at
# http://localhost:4000 from where `vite` itself runs (see vite.config.ts's
# proxy config, which is what actually forwards the browser's /api/* calls
# — this only affects the target of that proxy, not anything the browser
# sees directly, so there's no CORS/forwarded-hostname footgun here the way
# there was under the old Next.js setup).
# RESOURCE_SERVER_URL=http://localhost:4000

# Only needed in a cloud dev environment (Codespaces or similar) where the
# browser reaches this dev server through an HTTPS-forwarded preview URL
# rather than localhost:3000 directly. Without this, Vite's HMR websocket
# tries to connect straight to the container's internal port instead of
# through the forwarding proxy and fails with "WebSocket connection...
# failed" / "failed to connect to websocket" in the browser console — the
# app still works, but changes won't hot-reload without a manual refresh.
# Set to 443 (the forwarded HTTPS port almost every such proxy uses).
# VITE_HMR_CLIENT_PORT=443

# Set to "true" to preview the /p/:postId paywall UI with a hardcoded
# example bundle (lib/mockPost.ts) instead of the real teaser fetch + the
# Privy/Hedera/x402 flow — useful for evaluating the visual design without
# a working ENS/Hedera/Privy backend. Never set this in a real deployment.
# VITE_DEV_MODE=true
