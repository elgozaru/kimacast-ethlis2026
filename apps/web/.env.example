# From the Privy dashboard (dashboard.privy.io) → your app → Settings.
NEXT_PUBLIC_PRIVY_APP_ID=CHANGE_ME
PRIVY_APP_ID=CHANGE_ME
# Server-only secret used by app/api/hedera/sign to call Privy's Wallet API.
# Never expose this with a NEXT_PUBLIC_ prefix.
PRIVY_APP_SECRET=CHANGE_ME

NEXT_PUBLIC_HEDERA_NETWORK=hedera:testnet

# Only needed for a plain local setup (this app on localhost, resource-server
# on localhost). In a cloud dev environment where the page itself is served
# from a forwarded preview URL (e.g. https://<name>-3000.app.github.dev),
# leave this UNSET — lib/resource-server-url.ts auto-detects the forwarded
# URL for port 4000 from the browser's own hostname. Set this explicitly
# only to override that (e.g. resource-server deployed somewhere else) —
# note that lib/resource-server-url.ts ignores this value if it points at
# localhost while the page itself was loaded from a forwarded hostname,
# since that combination is almost always a stale copy-paste rather than
# an intentional override.
# NEXT_PUBLIC_RESOURCE_SERVER_URL=http://localhost:4000
