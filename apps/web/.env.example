# From the Privy dashboard (dashboard.privy.io) → your app → Settings.
NEXT_PUBLIC_PRIVY_APP_ID=CHANGE_ME
PRIVY_APP_ID=CHANGE_ME
# Server-only secret used by app/api/hedera/sign to call Privy's Wallet API.
# Never expose this with a NEXT_PUBLIC_ prefix.
PRIVY_APP_SECRET=CHANGE_ME

NEXT_PUBLIC_HEDERA_NETWORK=hedera:testnet
NEXT_PUBLIC_RESOURCE_SERVER_URL=http://localhost:4000
