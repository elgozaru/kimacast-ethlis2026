{
  "name": "kimacast-ethlis2026",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev:facilitator": "pnpm --filter facilitator dev",
    "dev:resource-server": "pnpm --filter resource-server dev",
    "dev:web": "pnpm --filter web dev",
    "dev:dashboard-api": "pnpm --filter dashboard-api dev",
    "dev:dashboard": "pnpm --filter dashboard dev",
    "dev": "pnpm --parallel --filter facilitator --filter resource-server --filter web --filter dashboard-api --filter dashboard dev",
    "db:generate": "pnpm --filter @kimacast/db generate",
    "db:migrate": "pnpm --filter @kimacast/db migrate:dev"
  }
}
