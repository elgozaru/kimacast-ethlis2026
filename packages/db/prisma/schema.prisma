generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A deployed content-publisher agent: one creator's syndication identity,
/// with its own ENS subname, generation settings, and free/gated split rules.
model Agent {
  id              String   @id @default(cuid())
  /// The Privy DID (did:privy:...) of the creator who owns this agent in
  /// the dashboard - an auth-scoping identity, NOT an Ethereum address.
  /// Never pass this to an ethers/ENS call expecting an address; look up
  /// the creator's actual linked wallet via auth.ts's
  /// getCreatorWalletAddress() for that.
  creatorId       String
  name            String
  /// e.g. "alice-tech.kymacast.eth" - set once ENS subname minting succeeds.
  ensSubname      String?  @unique
  capabilities    String[]
  /// "author-authorized" | "public-domain" | ... - who may be summarized.
  sourcePolicy    String   @default("author-authorized")
  /// Free-form settings: prompt tone, free/gated split criteria, price.
  settings        Json
  /// Hedera account (or ENS-resolved payTo) that story payments settle to.
  hederaPayTo     String?
  /// This agent's id in AgentRegistry.sol (packages/contracts), set once
  /// registerAgent() succeeds during deploy - see ens/subname.ts's sibling
  /// module, contracts/agentRegistry.ts. Not required for the platform to
  /// function; it's a separate, independently-queryable on-chain ledger.
  onChainAgentId  String?
  reputationScore Int      @default(0)
  status          String   @default("draft")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sources           ContentSource[]
  authorProfiles    AuthorProfile[]
  generationResults GenerationResult[]
  posts             Post[]
}

/// The author's tone/style profile used to steer generation - matches
/// author-profile.json.
model AuthorProfile {
  id              String   @id @default(cuid())
  agentId         String
  agent           Agent    @relation(fields: [agentId], references: [id])
  profileHash     String   @unique
  toneDescription String
  data            Json
  createdAt       DateTime @default(now())

  generationResults GenerationResult[]
}

/// An immutable snapshot of one piece of source content (article/PDF/RSS
/// item) at the moment it was retrieved - matches the "immutable source
/// snapshot" shape. Re-fetching the same canonicalUrl later and getting a
/// different contentHash is what triggers re-evaluation.
model ContentSource {
  id           String   @id @default(cuid())
  agentId      String
  agent        Agent    @relation(fields: [agentId], references: [id])
  author       String?
  canonicalUrl String?
  title        String
  content      String   @db.Text
  /// Unique per agent, not globally: two different agents legitimately
  /// ingesting the same article (or the same agent resubmitting identical
  /// text - e.g. re-testing a different generation provider against the
  /// same source) must not collide. A bare @unique here previously caused
  /// exactly that: any repeat of identical content anywhere in the table
  /// hit a raw DB constraint error instead of the idempotent reuse the
  /// route now does (see routes/content.ts).
  contentHash  String
  /// "text" | "url" | "pdf" | "rss" - how this snapshot was retrieved.
  /// Display-only; content/contentHash are already kind-agnostic by the
  /// time they reach this row (see buildSnapshot in content/snapshot.ts).
  sourceType   String   @default("text")
  /// 0g://<rootHash> once uploaded to 0G Storage.
  storageUri   String?
  retrievedAt  DateTime @default(now())
  createdAt    DateTime @default(now())

  generationResults GenerationResult[]

  @@unique([agentId, contentHash])
}

/// One run of the generation pipeline against a ContentSource - matches
/// both the "author configuration" and "required response object" shapes
/// (agentId, sourceHash, authorProfileHash, outputStorageId, content,
/// generation.{provider,model,promptVersion}).
model GenerationResult {
  id                String         @id @default(cuid())
  agentId           String
  agent             Agent          @relation(fields: [agentId], references: [id])
  sourceId          String
  source            ContentSource  @relation(fields: [sourceId], references: [id])
  authorProfileId   String?
  authorProfile     AuthorProfile? @relation(fields: [authorProfileId], references: [id])
  sourceHash        String
  authorProfileHash String?
  /// 0g://<rootHash> once the result itself is uploaded to 0G Storage.
  outputStorageId   String?
  /// { short_post, three_post_thread, linkedin_summary, claims_used, source_url }
  content           Json
  provider          String
  model             String
  promptVersion     String
  createdAt         DateTime       @default(now())

  posts Post[]
}

/// A concrete teaser/full-story pair, gated by apps/resource-server's
/// existing x402-over-Hedera paywall (GET /api/stories/:postId/{teaser,full}).
/// This is the row apps/resource-server reads to serve a dashboard-created
/// post through the same route pattern as the original hardcoded demo post.
model Post {
  id                 String            @id @default(cuid())
  agentId            String
  agent              Agent             @relation(fields: [agentId], references: [id])
  generationResultId String?
  generationResult   GenerationResult? @relation(fields: [generationResultId], references: [id])
  teaser             String            @db.Text
  full               String            @db.Text
  priceTinybars      String
  sourceUrl          String
  /// "pending" | "approved" | "rejected" | "scheduled" | "published" | "failed"
  /// "failed" means the poller (or a manual publish) ran but every bound
  /// channel came back unpublished (e.g. every connection had expired by
  /// fire time) - see PostPublication for the real per-channel outcome;
  /// this field is just the aggregate signal that something needs the
  /// creator's attention.
  status             String            @default("pending")
  /// Set together with status="scheduled" - the poller in
  /// routes/posts.ts's runScheduledPublishes() publishes any post whose
  /// scheduledFor has passed, flipping status to "published" (or "failed")
  /// the same way a manual POST /posts/:postId/publish does.
  scheduledFor       DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  publications PostPublication[]
}

/// One creator's connected social account - independent of any agent.
/// A creator can hold several connections for the same platform (e.g. two
/// X accounts); which one an agent actually posts through is decided per
/// publish/schedule action (see PostPublication), not fixed here or on
/// Agent.settings. creatorId is a Privy DID string, same convention as
/// Agent.creatorId - there's no separate Creator table to relate to.
model SocialConnection {
  id                 String    @id @default(cuid())
  creatorId          String
  /// "x" | "instagram" - Telegram deliberately has no SocialConnection: it
  /// stays on the bot-admin model (one platform bot token, a per-agent
  /// destination chat id), since there's no per-creator OAuth login for a
  /// Telegram bot to connect to.
  platform           String
  platformUserId     String
  platformUsername   String
  /// AES-256-GCM ciphertext (see social/tokenCrypto.ts) - never the raw
  /// token. Nothing reading this table should ever return these fields to
  /// the dashboard UI.
  accessTokenEnc     String
  refreshTokenEnc    String?
  expiresAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  publications PostPublication[]

  @@unique([creatorId, platform, platformUserId])
}

/// One channel's publish target + outcome for one Post, bound at the
/// moment the creator takes the publish/schedule action - NOT re-resolved
/// later, so a creator reconnecting or revoking an account between
/// scheduling and the scheduled time can't silently change which account a
/// queued post goes out under (see routes/posts.ts's runScheduledPublishes).
/// agentId is denormalized from post.agentId purely so "most recently used
/// connection for this agent+channel" (the schedule/publish UI's default)
/// is a single indexed query instead of a join through Post every time.
model PostPublication {
  id                 String            @id @default(cuid())
  postId             String
  post               Post              @relation(fields: [postId], references: [id])
  agentId            String
  /// "x" | "telegram" | "instagram"
  channel            String
  /// Null for Telegram (bot-admin model, no per-creator connection to bind).
  socialConnectionId String?
  socialConnection   SocialConnection? @relation(fields: [socialConnectionId], references: [id])
  /// "pending" | "published" | "failed"
  status             String            @default("pending")
  platformPostId     String?
  errorMessage       String?
  publishedAt        DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([agentId, channel, publishedAt])
}

/// Short-lived server-side record bridging GET /social/:platform/connect
/// (authenticated - knows creatorId, generates this row) and GET
/// /social/:platform/callback (unauthenticated - it's a browser redirect
/// from X/Meta, no Bearer token available, so creatorId + the OAuth 2.0
/// PKCE code_verifier have to be recovered from somewhere keyed only by
/// the `state` value the platform hands back). Deleted once consumed by
/// the callback; a row that's never consumed (abandoned login) just goes
/// stale and is harmless to leave - no cleanup job for this iteration.
model OAuthState {
  state        String   @id
  creatorId    String
  platform     String
  codeVerifier String
  createdAt    DateTime @default(now())
}
