# --- Source content ---
SOURCE_URL=https://www.bbc.com/news

# --- 0G Storage (decentralized storage for the "paid half" of each story) ---
ZEROG_STORAGE_RPC=https://evmrpc-testnet.0g.ai
ZEROG_STORAGE_INDEXER=https://indexer-storage-testnet-turbo.0g.ai
ZEROG_STORAGE_PRIVATE_KEY=

# --- 0G Compute Network (decentralized inference marketplace used to run the
#     hook-writer / summarizer / splitter model instead of a centralized LLM API) ---
ZEROG_COMPUTE_RPC=https://evmrpc-testnet.0g.ai
ZEROG_COMPUTE_PRIVATE_KEY=
ZEROG_COMPUTE_MODEL_PROVIDER=

# --- Privy (embedded wallet + Apple/Google Pay onramp for end viewers) ---
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# --- ZeroDev (ERC-4337 smart account / session keys on top of the Privy signer) ---
ZERODEV_PROJECT_ID=
ZERODEV_BUNDLER_RPC=

# --- Hedera (settlement network for x402 payments, via its EVM-compatible JSON-RPC relay) ---
HEDERA_NETWORK=testnet
HEDERA_JSON_RPC_URL=https://testnet.hashio.io/api
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
HEDERA_PAYMENT_TOKEN=HBAR

# --- x402 (HTTP 402 payment-required paywall protocol) ---
X402_RECEIVING_ADDRESS=
X402_PRICE_USD=0.05
X402_FACILITATOR_URL=

# --- Instagram (Meta Graph API, for publishing the free-teaser posts) ---
IG_BUSINESS_ACCOUNT_ID=
IG_ACCESS_TOKEN=
