# --- X (Twitter) API v2 credentials ---
# From the X Developer Portal, under your App's "Keys and tokens" tab.
# Never commit real values - this file is a template only (the real
# .env is gitignored). If any of these have ever been pasted into a
# chat, ticket, or shared doc, regenerate them before using this project.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# --- Anthropic API (the "Claude brain" behind the Research + Content agents) ---
ANTHROPIC_API_KEY=

# --- 0G Storage (shared memory between the Research, Content, and Analytics agents) ---
ZEROG_STORAGE_RPC=https://evmrpc-testnet.0g.ai
ZEROG_STORAGE_INDEXER=https://indexer-storage-testnet-turbo.0g.ai
ZEROG_STORAGE_PRIVATE_KEY=

# --- Pipeline input ---
SOURCE_URL=https://example.com
